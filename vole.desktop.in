[Desktop Entry]
Type=Application
Name=vole
GenericName=Gaming Mouse Configuration
Comment=Configure Endgame Gear wireless mice — CPI, polling, buttons and sensor
# Absolute, and written at install time from the prefix actually in use -- see
# cmake/InstallDesktopFile.cmake.in. A bare "vole-gui" is resolved against the
# DESKTOP SESSION's PATH, which is not the shell's: a --prefix ~/.local install
# puts the binary in ~/.local/bin, which plenty of sessions do not have on PATH,
# and the launcher then silently does nothing. Do not hardcode a prefix here.
Exec=__VOLE_EXEC__
Icon=vole
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=mouse;dpi;cpi;polling;lift-off;hid;endgame;op1w;xm2w;
StartupNotify=true
# Qt derives WM_CLASS from QApplication::applicationName(), which main.cpp sets
# to "vole". Without this, desktops that match windows to launchers by class
# show the window with a generic icon even though the launcher has the right one.
StartupWMClass=vole
